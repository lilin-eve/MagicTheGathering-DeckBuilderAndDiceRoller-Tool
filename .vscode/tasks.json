//  premade tasks.json file for C++ linux usage
//  
{
    "tasks": [
        {
            "type": "shell",
            "label": "C/C++: g++ build active file",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-ggdb",                                    //  for debugging
                //  "-02",                                  //  for release builds
                //  "-DNDEBUG",                             //
                "-pedantic-errors",                         //  strict ISO C++ standards, treats those warnings as errors
                "-Wall",                                    //  increases warnings
                "-Weffc++",                                 //
                "-Wextra",                                  //
                "-Wconversion",                             //
                "-Wsign-conversion",                        //
                "-Werror",                                  //  treats warnings as errors(halts program)
                "-std=c++23",                               //  sets c++ language standard to 23
                //  "${file}",                              //  builds current file only
                "${workspaceFolder}/*.cpp",                 //  builds all .cpp files in current directory
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "/usr/bin"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ],
    "version": "2.0.0"
}
